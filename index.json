{
  "schema_version": 1,
  "repository": {
    "id": "custom.juying-search",
    "name": "聚影资源搜索 插件仓库",
    "homepage": "https://github.com/lllp366/dian115-juying-plugins"
  },
  "plugins": [
    {
      "id": "custom.juying-search",
      "name": "聚影资源搜索",
      "version": "1.0.1",
      "description": "搜索聚影（juying.top）站内与 PanSou 的聚合资源，115 网盘优先展示，一键加入 DIAN115 聚合订阅。",
      "author": "DIAN115 自定义",
      "homepage": "https://www.jying.top",
      "package_url": "https://cdn.jsdelivr.net/gh/lllp366/dian115-juying-plugins@main/plugins/custom.juying-search-1.0.1.d115p",
      "sha256": "4dbe558a80a4be985a44417e590abf61a98654268cb3106757c163b11f509fdb",
      "runtime": {
        "kind": "wasm",
        "protocol": "dian115:wasm@1",
        "autostart": true,
        "trust_level": "wasm-sandbox"
      },
      "tags": [
        "juying",
        "search",
        "subscription"
      ],
      "permissions": {
        "apis": [
          {
            "method": "GET",
            "path": "/api/plugin-runtime/storage/:key",
            "reason": "读取已保存的聚影 App-Id 与 API Key"
          },
          {
            "method": "PUT",
            "path": "/api/plugin-runtime/storage/:key",
            "reason": "保存聚影 App-Id 与 API Key"
          },
          {
            "method": "POST",
            "path": "/api/subscribe/pool/intents",
            "reason": "把用户点选的影片加入 DIAN115 聚合订阅"
          }
        ],
        "network": [
          {
            "origin": "https://www.jying.top",
            "methods": [
              "GET"
            ],
            "proxy_mode": "system",
            "reason": "只读调用聚影开发者接口：聚合搜索与影片/TMDB 信息"
          }
        ]
      }
    }
  ]
}